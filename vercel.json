{
  "version": 2,
  "builds": [
    {
      "src": "backend/vercel_dist/index.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": { "outputDirectory": ".next" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/vercel_dist/index.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/vercel_dist/index.cjs"
    }
  ],
  "installCommand": "cd frontend && npm install && cd ../backend && npm install",
  "buildCommand": "cd frontend && npm run build && cd ../backend && npm run build:bundle"
}
