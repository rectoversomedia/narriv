{
  "name": "narriv-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "e2e:sandbox": "playwright test -c e2e-sandbox/playwright.config.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "next": "^16.2.10"
  }
}
