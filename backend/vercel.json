{
  "version": 2,
  "rootDirectory": ".",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install --ignore-scripts",
  "builds": [
    {
      "src": "dist/index.cjs",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    }
  ]
}
