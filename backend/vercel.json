{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "version": 2,
  "regions": [
    "hnd1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/ingest?slot=hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/social",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/demo-refresh",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/health",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "buildCommand": "npm install --ignore-scripts --include=dev && npm run build",
  "fluid": true
}
