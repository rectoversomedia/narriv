{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build",
    "startCommand": "npm start"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "healthchecks": {
    "web": {
      "path": "/api/cron/health-check",
      "intervalSeconds": 30,
      "timeoutSeconds": 10,
      "startupSeconds": 30
    }
  }
}